MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7236803575437696660}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e72a02e855ccaaf47b3e553c1f8300bb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteractableObject
  titulo: Birthday Balloon
  textoConteudo: 'There were sirens.


    There was smoke.


    There were bodies
    covered by thermal sheets.


    And there was a balloon with the number 8 still
    tied to a bench.


    I don''t remember falling to my knees.


    I only remember
    screaming.


    -Evelyn Graves'
  distanciaInteracao: 3
